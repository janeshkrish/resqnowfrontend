# Public production origin only; do not append /api. For local development use a
# .env.local file with an HTTP localhost/LAN backend instead.
VITE_API_URL=https://resqnowbackend-production-c392.up.railway.app
VITE_FRONTEND_ONLY=false

# Client-safe provider settings: obtain approved values before release.
# Never add database passwords, Firebase Admin private keys or payment secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_MAPPLS_MAP_SDK_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_MAPS_API_KEY=
