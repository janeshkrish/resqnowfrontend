<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy: HTTPS only, system CAs only.
  Debug and updaterAcceptance builds override this file from their own source
  sets so emulators can reach local servers. Do not relax it here:
  scripts/android-network-policy.test.mjs fails the release check if you do.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
